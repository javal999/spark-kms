# Local dev database (Homebrew Postgres 16, pg_trgm enabled)
DATABASE_URL=postgresql://USER@localhost:5432/spark_kms
# Separate database used by integration/e2e tests (wiped between runs)
TEST_DATABASE_URL=postgresql://USER@localhost:5432/spark_kms_test
# iron-session cookie encryption secret (>= 32 chars). Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars-long
